# ============================================================
# WHATSAPP CALENDAR ASSISTANT — Variables de entorno
# Copia este archivo como .env y rellena cada valor
# ============================================================

# --- WhatsApp Cloud API (Meta) ---
# Token de acceso permanente de tu app de Meta Business
WHATSAPP_TOKEN=tu_token_de_acceso_permanente_aqui

# ID del número de teléfono de WhatsApp Business registrado
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui

# Token secreto que TÚ inventas para verificar el webhook de Meta
# Puede ser cualquier string seguro, ej: "mi_secreto_webhook_2024"
WHATSAPP_VERIFY_TOKEN=tu_verify_token_inventado_aqui

# ID de la aplicación de Meta (App ID) — lo ves en el panel de Meta Developers
META_APP_SECRET=tu_app_secret_aqui

# --- Anthropic Claude API ---
# Tu API Key de Anthropic (empieza con sk-ant-)
ANTHROPIC_API_KEY=sk-ant-tu_api_key_aqui

# --- Google Calendar (Service Account) ---
# Email de la cuenta de servicio (termina en @...iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-sa@tu-proyecto.iam.gserviceaccount.com

# Clave privada de la cuenta de servicio (el bloque -----BEGIN PRIVATE KEY-----)
# En Railway/Render, pégala tal cual incluyendo los saltos de línea (\n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# ID del Google Calendar donde se crearán los eventos
# Para el calendario principal es el email del dueño, ej: cliente@gmail.com
# Para calendarios secundarios usa el ID largo de Configuración > Integrar calendario
GOOGLE_CALENDAR_ID=email_del_calendario_o_id_aqui

# --- Servidor ---
# Puerto en que escucha el servidor (Railway/Render lo sobrescriben automáticamente)
PORT=3000

# Zona horaria (no cambiar)
TZ=America/Santiago
